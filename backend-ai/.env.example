# Google Gemini API Key (Obtain from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
# Alternative fallback variable name
# GOOGLE_API_KEY=your_google_api_key_here

# Gemini Model Identifier
GEMINI_MODEL=gemini-3.8-flash

# Supabase Credentials (Optional for Backend Microservice Admin operations)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Server Configuration
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080
